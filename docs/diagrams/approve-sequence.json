{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Approve and Post a Quarantined Entry",
    "locale": "en",
    "output": "docs/diagrams/approve-sequence.html",
    "viewBox": [
      1080,
      900
    ],
    "animation": "trace",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "views": [
      {
        "id": "submit",
        "label": "Reviewer submits",
        "focus": [
          "panel",
          "hook",
          "route"
        ],
        "note": "DecisionPanel calls the useDecision mutation, which POSTs the decision."
      },
      {
        "id": "validate",
        "label": "Checks before writing",
        "focus": [
          "route",
          "service"
        ],
        "note": "Entry must exist and be QUARANTINED; action approve or reject; name required; reason 10 to 2,000 characters."
      },
      {
        "id": "commit",
        "label": "Record, post, audit",
        "focus": [
          "service",
          "lock",
          "store",
          "posting"
        ],
        "note": "Under one lock: refuse a second decision, save it, re-post the trial balance, log it to the audit trail."
      },
      {
        "id": "refresh",
        "label": "Screen refreshes",
        "focus": [
          "hook",
          "panel"
        ],
        "note": "After the mutation settles the hook refetches six cached views; DecisionPanel then shows the success toast."
      }
    ]
  },
  "participants": [
    {
      "id": "panel",
      "type": "frontend",
      "label": "Reviewer screen",
      "sublabel": "DecisionPanel"
    },
    {
      "id": "hook",
      "type": "frontend",
      "label": "useDecision",
      "sublabel": "React Query"
    },
    {
      "id": "route",
      "type": "backend",
      "label": "API route",
      "sublabel": "POST …/decision"
    },
    {
      "id": "service",
      "type": "backend",
      "label": "record_decision",
      "sublabel": "api/service.py"
    },
    {
      "id": "lock",
      "type": "security",
      "label": "Decision lock",
      "sublabel": "_DECISION_LOCK"
    },
    {
      "id": "posting",
      "type": "backend",
      "label": "posting.post",
      "sublabel": "adjusted TB"
    },
    {
      "id": "store",
      "type": "database",
      "label": "RunStore",
      "sublabel": "output/runs/<run_id>"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 240,
      "label": "Submit"
    },
    {
      "from": 250,
      "to": 322,
      "label": "Validate"
    },
    {
      "from": 330,
      "to": 670,
      "label": "Record and post (locked)"
    },
    {
      "from": 680,
      "to": 780,
      "label": "Refresh"
    }
  ],
  "messages": [
    {
      "from": "panel",
      "to": "hook",
      "y": 160,
      "label": "mutate: approve, name + reason",
      "variant": "emphasis"
    },
    {
      "from": "hook",
      "to": "route",
      "y": 194,
      "label": "POST /api/runs/{id}/entries/{je}/decision",
      "variant": "emphasis"
    },
    {
      "from": "route",
      "to": "service",
      "y": 228,
      "label": "record_decision(action, actor, reason)",
      "variant": "emphasis"
    },
    {
      "from": "service",
      "to": "store",
      "y": 270,
      "label": "load run results, find entry",
      "variant": "default"
    },
    {
      "from": "service",
      "to": "route",
      "y": 304,
      "label": "404 / 400 if not QUARANTINED or bad input",
      "variant": "return"
    },
    {
      "from": "service",
      "to": "lock",
      "y": 346,
      "label": "acquire lock",
      "variant": "security"
    },
    {
      "from": "service",
      "to": "store",
      "y": 380,
      "label": "already decided?",
      "variant": "default"
    },
    {
      "from": "service",
      "to": "route",
      "y": 414,
      "label": "409 already_decided",
      "variant": "return"
    },
    {
      "from": "service",
      "to": "store",
      "y": 448,
      "label": "append human_decisions.json (atomic)",
      "variant": "emphasis"
    },
    {
      "from": "service",
      "to": "posting",
      "y": 482,
      "label": "re-post TB with human decisions",
      "variant": "emphasis"
    },
    {
      "from": "posting",
      "to": "service",
      "y": 516,
      "label": "posted lines (409 if imbalance changes)",
      "variant": "return"
    },
    {
      "from": "service",
      "to": "store",
      "y": 550,
      "label": "write posted_tb.json + .csv",
      "variant": "emphasis"
    },
    {
      "from": "service",
      "to": "store",
      "y": 584,
      "label": "audit: decision.human, post.completed",
      "variant": "dashed"
    },
    {
      "from": "service",
      "to": "lock",
      "y": 618,
      "label": "release lock",
      "variant": "security"
    },
    {
      "from": "service",
      "to": "route",
      "y": 652,
      "label": "entry view (APPROVED)",
      "variant": "return"
    },
    {
      "from": "route",
      "to": "hook",
      "y": 694,
      "label": "200 updated entry",
      "variant": "return"
    },
    {
      "from": "hook",
      "to": "route",
      "y": 728,
      "label": "invalidate + refetch 6 queries",
      "variant": "dashed"
    },
    {
      "from": "hook",
      "to": "panel",
      "y": 762,
      "label": "onSuccess: toast Approved and posted",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "hook",
      "from": 154,
      "to": 770,
      "type": "frontend"
    },
    {
      "participant": "route",
      "from": 188,
      "to": 702,
      "type": "backend"
    },
    {
      "participant": "service",
      "from": 222,
      "to": 660,
      "type": "backend"
    },
    {
      "participant": "lock",
      "from": 340,
      "to": 626,
      "type": "security"
    },
    {
      "participant": "posting",
      "from": 476,
      "to": 524,
      "type": "backend"
    },
    {
      "participant": "store",
      "from": 264,
      "to": 592,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Error returns",
      "items": [
        "404 run_not_found / entry_not_found; 400 entry_rejected, entry_already_posted",
        "400 invalid_action, actor_required, reason_too_short / too_long",
        "409 already_decided: decisions are final",
        "409 posting_invariant_failed: decision is already saved, TB files not rewritten"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why the lock",
      "items": [
        "One process-wide lock wraps check-then-write",
        "Two reviewers cannot both decide the same entry",
        "JSON/CSV via temp file + replace; audit log is appended"
      ]
    },
    {
      "dot": "emerald",
      "title": "Screen refresh",
      "items": [
        "Refetches entries, entry, posted TB, lineage, audit log and trace",
        "Toast (from DecisionPanel) shows entry id and reviewer name",
        "Human decisions are stored apart from decisions.json"
      ]
    }
  ]
}
